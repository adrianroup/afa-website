<script>
  // ── Variant IDs ──────────────────────────────────────────
  // Base pre-order variants
  const BASE_VARIANTS = {
    scans: '53348992549163',  // 10 Scans pre-order $10
    ebook: '53313578434859',  // eBook $14
    audio: '53313578598699',  // Audiobook $15
    hard:  '53313578729771'   // Hardcover $49
  };

  // Upsell chains per base selection
  // Each entry: { variant, stepEl } — stepEl = id of upsell-step div
  const CHAINS = {
    // Scans selected: eBook → Audiobook → Logbook → Hardcover → Academy
    scans: [
      { variant: '53349028528427', step: 'upsell-step-scans-0' },
      { variant: '53348955095339', step: 'upsell-step-scans-1' },
      { variant: '53348935336235', step: 'upsell-step-scans-2' },
      { variant: '53348951458091', step: 'upsell-step-scans-3' },
      { variant: '53348944806187', step: 'upsell-step-scans-4' }
    ],
    // eBook/Audio/Hard selected: Audiobook → Logbook → Hardcover → Academy → Scans
    default: [
      { variant: '53348955095339', step: 'upsell-step-def-0' },
      { variant: '53348935336235', step: 'upsell-step-def-1' },
      { variant: '53348951458091', step: 'upsell-step-def-2' },
      { variant: '53348944806187', step: 'upsell-step-def-3' },
      { variant: '53348902863147', step: 'upsell-step-def-4' }
    ]
  };

  const CTA_LABELS = {
    scans: 'Pre-order 10 Scans — $10 →',
    ebook: 'Pre-order eBook — $14 →',
    audio: 'Pre-order Audiobook — $15 →',
    hard:  'Pre-order Hardcover — $49 →'
  };

  let currentStep = 0;
  let activeChain = null;
  let baseVariant = null;
  let addedVariants = [];

  const overlay = document.getElementById('upsell-overlay');
  const cards = document.querySelectorAll('.option-card');
  const ctaBtn = document.getElementById('cta-btn');
  let selected = null;

  // Card selection
  cards.forEach(card => {
    card.addEventListener('click', () => {
      cards.forEach(c => c.classList.remove('selected'));
      card.classList.add('selected');
      const radio = card.querySelector('input[type="radio"]');
      radio.checked = true;
      selected = radio.value;
      ctaBtn.textContent = CTA_LABELS[selected] || 'Continue →';
      ctaBtn.href = '#';
      ctaBtn.style.pointerEvents = 'auto';
      ctaBtn.style.opacity = '1';
    });
  });

  // Main CTA click
  ctaBtn.addEventListener('click', e => {
    e.preventDefault();
    if (!selected) {
      cards.forEach(c => {
        c.style.borderColor = 'rgba(192,57,43,0.4)';
        setTimeout(() => { c.style.borderColor = ''; }, 600);
      });
      return;
    }
    baseVariant = BASE_VARIANTS[selected];
    activeChain = CHAINS[selected] || CHAINS.default;
    addedVariants = [];
    currentStep = 0;
    updateProgressDots(0, activeChain.length);
    showChainStep(0);
    overlay.classList.add('active');
    document.body.style.overflow = 'hidden';
  });

  function showChainStep(step) {
    // Hide all upsell steps
    document.querySelectorAll('.upsell-step').forEach(s => s.classList.remove('active'));
    // Show the correct step for this chain
    const stepEl = document.getElementById(activeChain[step].step);
    if (stepEl) stepEl.classList.add('active');
    updateProgressDots(step, activeChain.length);
  }

  function updateProgressDots(step, total) {
    for (let i = 0; i < 5; i++) {
      const dot = document.getElementById('dot-' + i);
      if (!dot) continue;
      dot.classList.remove('done', 'current');
      if (i < step) dot.classList.add('done');
      else if (i === step) dot.classList.add('current');
    }
  }

  function nextStep() {
    currentStep++;
    if (currentStep >= activeChain.length) {
      goToCheckout();
    } else {
      showChainStep(currentStep);
    }
  }

  function goToCheckout() {
    overlay.classList.remove('active');
    document.body.style.overflow = '';
    let items = baseVariant + ':1';
    addedVariants.forEach(v => { items += ',' + v + ':1'; });
    let url = 'https://anaudiencefromanywhere.myshopify.com/cart/' + items;
    // Append UTMs from sessionStorage if present
    try {
      var stored = sessionStorage.getItem('afa_utms');
      if (stored) {
        var utms = JSON.parse(stored);
        var keys = ['utm_source','utm_medium','utm_campaign','utm_id','utm_term','utm_content'];
        var pairs = keys.filter(k => utms[k]).map(k => encodeURIComponent(k) + '=' + encodeURIComponent(utms[k]));
        if (pairs.length && url.indexOf('utm_') === -1) {
          url += (url.indexOf('?') !== -1 ? '&' : '?') + pairs.join('&');
        }
      }
    } catch(e) {}
    window.location.href = url;
  }

  // Yes/No buttons — delegated
  overlay.addEventListener('click', e => {
    const yes = e.target.closest('.upsell-yes');
    const no  = e.target.closest('.upsell-no');
    if (yes) {
      addedVariants.push(yes.dataset.variant);
      nextStep();
    } else if (no) {
      nextStep();
    }
  });
</script>

